{
  "name": "Elench",
  "scopeName": "source.elench",
  "fileTypes": [
    "eln",
    "tu"
  ],
  "comment": "Elench 语法高亮。关键词表与 src/lexer.py 的 KEYWORDS 逐字对应，由 src/test_editors.py 强制比对——两边不一致测试就会失败。",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#region"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#removed"
    },
    {
      "include": "#contextual"
    },
    {
      "include": "#types"
    },
    {
      "include": "#cost"
    },
    {
      "include": "#function-def"
    },
    {
      "include": "#dispatch"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#char"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.elench",
          "match": "//.*$"
        }
      ]
    },
    "region": {
      "comment": "折叠标记：// #region 名字 与 // #endregion",
      "patterns": [
        {
          "name": "meta.folding.elench",
          "match": "//\\s*#(?:end)?region\\b.*$"
        }
      ]
    },
    "keyword": {
      "comment": "= lexer.KEYWORDS（40 个）。改一边不改另一边，test_editors.py 会失败。",
      "name": "keyword.control.elench",
      "match": "\\b(?:and|break|continue|as|asm|assume|char|choose|const|dyn|else|enum|eof|error|extern|external|false|float|for|func|ident|if|impl|in|int|kernels|match|parallel|not|or|pub|return|rewrite|scope|self|spawn|spec|string|struct|trait|true|unsafe|use|while)\\b"
    },
    "removed": {
      "comment": "v0.68/v0.69 下线：词法仍识别，parser 报精确诊断。高亮成 deprecated，让读者看出不能再用。",
      "name": "invalid.deprecated.elench",
      "match": "\\b(?:end|fn|val|var)\\b"
    },
    "contextual": {
      "comment": "上下文关键字：只在 spec 体内有含义，词法上是普通标识符。",
      "name": "keyword.other.contextual.elench",
      "match": "\\b(?:target|benchmodel|data|scale|seed|over|objective|requires|effects|guarantees|decreases|pending|alloc)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.elench",
          "match": "\\b(?:bool|u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|f32|f64|usize|isize|void)\\b"
        },
        {
          "name": "support.type.container.elench",
          "match": "\\b(?:Vec|FixedVec|Option|Result|Slice)\\b"
        },
        {
          "name": "entity.name.type.elench",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "cost": {
      "comment": "成本表达式记号：O(...) 与 log/log2 原子，以及内建 min/max。",
      "patterns": [
        {
          "name": "support.class.cost.elench",
          "match": "\\bO(?=\\s*\\()"
        },
        {
          "name": "support.function.cost.elench",
          "match": "\\b(?:log2|log)(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.elench",
          "match": "\\b(?:min|max|len|abs)(?=\\s*\\()"
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "match": "\\b(func|spec)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.elench"
            },
            "2": {
              "name": "entity.name.function.elench"
            }
          }
        }
      ]
    },
    "dispatch": {
      "comment": "?!label(...) 是决策点：承诺按最慢候选算、执行按表挑最快。",
      "patterns": [
        {
          "match": "(\\?!)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.dispatch.elench"
            },
            "2": {
              "name": "entity.name.function.dispatch.elench"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.elench",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.float.elench",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.elench",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "char": {
      "patterns": [
        {
          "name": "string.quoted.single.elench",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "strings": {
      "comment": "规格 T5 现在只有 i64/u64/f64，没有字符串字面量；仍留一条规则，将来扩展时不静默失效。",
      "patterns": [
        {
          "name": "string.quoted.double.elench",
          "match": "\"(?:\\\\.|[^\"\\\\])*\""
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.elench",
          "match": "\\?!|\\?\\{|->|=>|::|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|\\?|=|<|>|\\+|-|\\*|/|%|!|&|\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.elench",
          "match": "[{}()\\[\\],;:.]"
        }
      ]
    }
  }
}
